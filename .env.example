# Copiar este archivo como ".env" y completar los valores.
# El archivo .env no se sube al repositorio.

# Base de datos PostgreSQL de la adaptación para docentes
# (la usan compose.yaml y src/config/database.py)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Base propia de esta rama, distinta de la del sistema original
POSTGRES_DB=asistencia_docentes
# Puerto de tu compu en el que se publica PostgreSQL. Si el stack original
# (asistencia-facial) sigue levantado en 5432, usar otro, por ejemplo 5433.
POSTGRES_PORT=5433
