# Copiar este archivo como ".env" y completar los valores.
# El archivo .env no se sube al repositorio.

# Base de datos PostgreSQL (la usan compose.yaml y src/config/database.py)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Puerto de tu compu en el que se publica PostgreSQL (por ejemplo 5432)
POSTGRES_PORT=
